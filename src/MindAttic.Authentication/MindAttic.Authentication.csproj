<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 7.0.0: MindAtticAuthSettings + MindAtticAuthOptions.SettingsSection so hosts edit auth options on their
         MindAttic Vault tab (LAMP); adds the MindAttic.Vault 7 dependency for the settings attributes. -->
    <Version>7.0.0</Version>
    <RootNamespace>MindAttic.Authentication</RootNamespace>
    <!-- Maximally-secure, Vault-backed authentication for the MindAttic ecosystem.
         OWASP ASVS L2/L3 · NIST SP 800-63B AAL2. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- DEV-ONLY auth bypass (Web/DevAuthBypass.cs) is wrapped in `#if MA_DEV_AUTH`.
       The symbol is defined ONLY in Debug, so a Release pack contains none of it.
       Pack Debug for the local dev feed; pack Release (CI default) for prod. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);MA_DEV_AUTH</DefineConstants>
  </PropertyGroup>

  <!-- Needs the full ASP.NET surface: authentication, Data Protection, antiforgery, hosting, components. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Secrets still resolve through plain IConfiguration (the host fills MindAttic:Vault:* via MindAttic.Vault,
         env vars or Key Vault). The Vault package is only for the [Setting] attributes on the option classes. -->
    <PackageReference Include="MindAttic.Vault" Version="7.0.0" />
    <!-- SMTP delivery for auth email (SmtpAuthEmailSender) — same library/version as MindAttic.Psst. -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- Argon2id (RFC 9106) — pure-managed, maintained. Exact-pinned per spec. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Legacy bcrypt verification for transparent upgrade-on-login. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Canonical EF model owned by the library (entities + IEntityTypeConfiguration). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <!-- Transitive (via MailKit/MimeKit) 10.0.0 carries GHSA-846f-f764-76mx (high) + GHSA-2fmv-rv2c-59x7
         (moderate), NU1903/NU1902. Pinned to the patched servicing release; drop once MailKit pulls it itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
